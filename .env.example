# podcast_server configuration. Copy to .env, fill in, then `chmod 600 .env`.
# Run `uv run python -m core.doctor` to verify.

# --- Show identity (required) ---
PODCAST_TITLE="My Show"
PODCAST_DESCRIPTION="One or two sentences about what the show covers."
PODCAST_AUTHOR="Your Name"
PODCAST_OWNER_EMAIL=you@example.com          # Apple's contact; also the owner in <podcast:locked>
PODCAST_LINK=https://example.com/podcast     # show homepage (episode pages live under it in astro mode)
PODCAST_FEED_URL=https://audio.example.com/feed.xml   # astro mode: e.g. https://example.com/podcast/rss.xml
PODCAST_IMAGE_URL=https://example.com/cover.jpg       # square JPEG/PNG, 1400-3000 px
EPISODE_GUID_PREFIX=myshow                   # GUIDs minted at publish: myshow-<slug>-<timestamp>

# --- Show metadata (optional) ---
# PODCAST_CATEGORY=Technology
# PODCAST_SUBCATEGORIES=["Artificial Intelligence"]
# PODCAST_LANGUAGE=en-us
# PODCAST_EXPLICIT=false
# DEFAULT_TAGS=["Interviews"]

# --- Cloudflare R2 (required) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=my-show-audio
R2_PUBLIC_DOMAIN=https://audio.example.com   # custom domain on the bucket; r2.dev is rate-limited
# USE_OP3_PREFIX=false                       # true = OP3 download analytics (stats are public)

# --- Website ---
# none:  no website; the feed is uploaded to R2 at R2_PUBLIC_DOMAIN/FEED_OBJECT_KEY
# astro: write episode pages + feed into a git-deployed site and push WEBSITE_BRANCH
SITE_MODE=none
# FEED_OBJECT_KEY=feed.xml
# WEBSITE_PATH=/path/to/your/site/checkout
# WEBSITE_RSS_FILE=public/podcast/rss.xml
# WEBSITE_EPISODES_DIR=src/content/podcast
# WEBSITE_BLOG_DIR=src/content/blog
# WEBSITE_BRANCH=main

# --- Show data location (catalog, transcripts, templates, backups) ---
# DATA_DIR=/path/to/my-show-data            # default: ./data inside this repo (gitignored)

# --- Optional integrations ---
# DESCRIPT_API_BEARER=your_descript_token   # sent only to descript.com hosts
# YOUTUBE_TOKEN_PATH=~/.config/podcast_server/youtube_token.json
# HF_BACKUP_REPO=your-hf-user/my-show-archive   # private dataset for scripts/backup_to_hf.py
# THUMBNAIL_STYLE="clean, high-contrast studio aesthetic"
# X_USERNAME=myshow                         # X handle (no @); enables podcast_post_to_x and X metrics via xurl
# XURL_APP=my-xurl-app                      # only if your xurl auth file holds more than one app
# XURL_PATH=/usr/local/bin/xurl             # default: first xurl on PATH
# PODCAST_GUID=                             # show <podcast:guid>; default derives from PODCAST_FEED_URL. Pin it before moving the feed.

# --- Audience metrics (each source turns on once its settings are present; see ADOPTING.md) ---
# OP3_API_TOKEN=your_op3_bearer_token       # free at https://op3.dev/api/keys (needs USE_OP3_PREFIX=true)
# OP3_SHOW_UUID=                            # optional; looked up from <podcast:guid> when unset
# CLOUDFLARE_API_TOKEN=your_cf_token        # Zone > Analytics > Read on the zone serving R2_PUBLIC_DOMAIN
# CLOUDFLARE_ZONE_ID=your_zone_id
# X_BEARER_TOKEN=                           # only without xurl: public X counts for X_USERNAME
# X_LOOKBACK_DAYS=30                        # re-read metrics for posts made via podcast_post_to_x this recent
# METRICS_SOURCES=["op3","cloudflare"]      # default: every configured source
# METRICS_EXTRA_COLLECTORS=["my_pkg.metrics:MyCollector"]
# METRICS_BACKFILL_DAYS=90                  # history fetched on a source's first run
